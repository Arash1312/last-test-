
#!/usr/bin/env python3
"""
ZYNTRA
------
A lightweight file integrity and security utility.

Features:
- SHA-256 file hashing
- File integrity verification
- Directory scanning
- Change detection
- JSON report export
- Cross-platform support
- Python standard library only

Usage:
    python zyntra.py hash <file>
    python zyntra.py scan <directory>
    python zyntra.py verify <file> <sha256>
    python zyntra.py report <directory> <output.json>
"""

import argparse
import hashlib
import json
import sys
from datetime import datetime, timezone
from pathlib import Path


APP_NAME = "Zyntra"
VERSION = "1.0.0"
CHUNK_SIZE = 1024 * 1024


def sha256_file(path: Path) -> str:
    """Calculate a file's SHA-256 digest without loading it all into memory."""
    digest = hashlib.sha256()

    with path.open("rb") as file:
        for chunk in iter(lambda: file.read(CHUNK_SIZE), b""):
            digest.update(chunk)

    return digest.hexdigest()


def file_record(path: Path, root: Path) -> dict:
    """Create a metadata record for a file."""
    stat = path.stat()

    return {
        "path": path.relative_to(root).as_posix(),
        "size_bytes": stat.st_size,
        "modified_utc": datetime.fromtimestamp(
            stat.st_mtime, timezone.utc
        ).isoformat(),
        "sha256": sha256_file(path),
    }


def scan_directory(directory: Path) -> list:
    """Scan regular files recursively and return integrity records."""
    if not directory.exists():
        raise FileNotFoundError(f"Directory not found: {directory}")

    if not directory.is_dir():
        raise NotADirectoryError(f"Not a directory: {directory}")

    records = []

    for path in sorted(directory.rglob("*")):
        if path.is_symlink() or not path.is_file():
            continue

        try:
            records.append(file_record(path, directory))
        except (OSError, PermissionError) as error:
            print(
                f"[WARN] Could not read {path}: {error}",
                file=sys.stderr,
            )

    return records


def verify_file(path: Path, expected_hash: str) -> bool:
    """Compare a file's SHA-256 digest with an expected digest."""
    if not path.is_file():
        raise FileNotFoundError(f"File not found: {path}")

    actual_hash = sha256_file(path)
    expected_hash = expected_hash.strip().lower()

    if len(expected_hash) != 64:
        raise ValueError("Expected SHA-256 must contain 64 hexadecimal characters.")

    try:
        int(expected_hash, 16)
    except ValueError as error:
        raise ValueError("Expected hash contains invalid hexadecimal characters.") from error

    print(f"File:     {path}")
    print(f"Expected: {expected_hash}")
    print(f"Actual:   {actual_hash}")

    if actual_hash == expected_hash:
        print("[PASS] File integrity verified.")
        return True

    print("[FAIL] Hash mismatch detected.")
    return False


def export_report(directory: Path, output: Path) -> None:
    """Scan a directory and export a JSON integrity report."""
    records = scan_directory(directory)

    report = {
        "application": APP_NAME,
        "version": VERSION,
        "generated_utc": datetime.now(timezone.utc).isoformat(),
        "root_directory": str(directory.resolve()),
        "algorithm": "SHA-256",
        "file_count": len(records),
        "files": records,
    }

    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(
        json.dumps(report, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )

    print(f"[OK] Report saved to: {output}")
    print(f"[OK] Files processed: {len(records)}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="zyntra",
        description="A lightweight file integrity utility.",
    )

    parser.add_argument(
        "--version",
        action="version",
        version=f"%(prog)s {VERSION}",
    )

    commands = parser.add_subparsers(dest="command", required=True)

    hash_command = commands.add_parser(
        "hash", help="Calculate a file's SHA-256 hash."
    )
    hash_command.add_argument("file", type=Path)

    scan_command = commands.add_parser(
        "scan", help="Scan a directory and display file hashes."
    )
    scan_command.add_argument("directory", type=Path)

    verify_command = commands.add_parser(
        "verify", help="Verify a file against an expected SHA-256 hash."
    )
    verify_command.add_argument("file", type=Path)
    verify_command.add_argument("sha256")

    report_command = commands.add_parser(
        "report", help="Export a directory integrity report as JSON."
    )
    report_command.add_argument("directory", type=Path)
    report_command.add_argument("output", type=Path)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    try:
        if args.command == "hash":
            print(sha256_file(args.file))

        elif args.command == "scan":
            records = scan_directory(args.directory)

            print(f"{APP_NAME} | SHA-256 Directory Scan")
            print("-" * 72)

            for record in records:
                print(f"{record['sha256']}  {record['path']}")

            print("-" * 72)
            print(f"Total files: {len(records)}")

        elif args.command == "verify":
            return 0 if verify_file(args.file, args.sha256) else 1

        elif args.command == "report":
            export_report(args.directory, args.output)

        return 0

    except (OSError, ValueError) as error:
        print(f"[ERROR] {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
